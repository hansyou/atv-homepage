{
  "name": "atv-homepage",
  "version": "1.0.0",
  "description": "Apple TV 风格个人主页 · Cloudflare Workers",
  "scripts": {
    "dev": "vite web",
    "build": "vite build web",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "vite build web && wrangler deploy",
    "db:init": "wrangler d1 execute atv-homepage --remote --file=schema.sql",
    "preview": "wrangler dev --ip 0.0.0.0",
    "db:init:local": "wrangler d1 execute atv-homepage --file=schema.sql --local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.149.0"
  }
}
